#include <GL/glut.h>
#include <cstdlib>

// =====================================================
// SMART TRAFFIC LIGHT - 2D + 3D COMPUTER GRAPHICS
// =====================================================

// Vehicle position
float posX = 0.0f;
float posY = 0.0f;
float posZ = 0.0f;

// Transformation
float rotation = 0.0f;
float scaleValue = 1.0f;

// 2D / 3D mode
bool is3D = true;

// Clipping plane
double clippingPlane[] = {1.0, 0.0, 0.0, 4.0};


// =====================================================
// CO1 - DRAW ROAD
// =====================================================

void drawRoad()
{
    glColor3f(0.12f, 0.12f, 0.12f);

    // Horizontal road
    glBegin(GL_QUADS);

        glVertex3f(-12, 0, -3);
        glVertex3f( 12, 0, -3);
        glVertex3f( 12, 0,  3);
        glVertex3f(-12, 0,  3);

    glEnd();

    // Vertical road
    glBegin(GL_QUADS);

        glVertex3f(-3, 0, -12);
        glVertex3f( 3, 0, -12);
        glVertex3f( 3, 0,  12);
        glVertex3f(-3, 0,  12);

    glEnd();


    // Road markings
    glColor3f(1, 1, 1);

    glBegin(GL_LINES);

        for (int i = -12; i <= 12; i += 2)
        {
            glVertex3f(i, 0.05f, -0.15f);
            glVertex3f(i + 1, 0.05f, -0.15f);
        }

    glEnd();
}


// =====================================================
// CO1 - 3D TRAFFIC SIGNAL
// =====================================================

void drawTrafficSignal()
{
    // Pole
    glColor3f(0.3f, 0.3f, 0.3f);

    glPushMatrix();

        glTranslatef(5, 2, 5);
        glScalef(0.3f, 4.0f, 0.3f);

        glutSolidCube(1);

    glPopMatrix();


    // Signal body
    glColor3f(0.05f, 0.05f, 0.05f);

    glPushMatrix();

        glTranslatef(5, 5, 5);
        glScalef(1.2f, 3.0f, 1.0f);

        glutSolidCube(1);

    glPopMatrix();


    // Red
    glColor3f(1, 0, 0);

    glPushMatrix();

        glTranslatef(5, 6, 5.5f);
        glutSolidSphere(0.35, 20, 20);

    glPopMatrix();


    // Yellow
    glColor3f(1, 1, 0);

    glPushMatrix();

        glTranslatef(5, 5, 5.5f);
        glutSolidSphere(0.35, 20, 20);

    glPopMatrix();


    // Green
    glColor3f(0, 1, 0);

    glPushMatrix();

        glTranslatef(5, 4, 5.5f);
        glutSolidSphere(0.35, 20, 20);

    glPopMatrix();
}


// =====================================================
// CO1 - EMERGENCY VEHICLE
// =====================================================

void drawEmergencyVehicle()
{
    glPushMatrix();

        // CO2 - Translation
        glTranslatef(
            -4 + posX,
            0.7f + posY,
            -4 + posZ
        );

        // CO2 - Rotation
        glRotatef(rotation, 0, 1, 0);

        // CO2 - Scaling
        glScalef(
            1.5f * scaleValue,
            0.7f * scaleValue,
            2.0f * scaleValue
        );

        // Vehicle body
        glColor3f(0.9f, 0.1f, 0.1f);

        glutSolidCube(1);

    glPopMatrix();


    // Emergency light
    glColor3f(0.1f, 0.5f, 1.0f);

    glPushMatrix();

        glTranslatef(
            -4 + posX,
            1.3f + posY,
            -4 + posZ
        );

        glutSolidSphere(0.2, 20, 20);

    glPopMatrix();
}


// =====================================================
// DISPLAY
// =====================================================

void display()
{
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();


    // =================================================
    // 3D VIEW
    // =================================================

    if (is3D)
    {
        // 3D camera
        gluLookAt(
            18, 15, 20,
             0,  0,  0,
             0,  1,  0
        );
    }

    // =================================================
    // 2D VIEW
    // =================================================

    else
    {
        // 2D camera
        gluLookAt(
            0, 20, 0,
            0,  0, 0,
            0,  0, -1
        );
    }


    // =================================================
    // CO3 - CLIPPING
    // =================================================

    glEnable(GL_CLIP_PLANE0);

    glClipPlane(
        GL_CLIP_PLANE0,
        clippingPlane
    );


    // Draw complete traffic scene
    drawRoad();
    drawTrafficSignal();
    drawEmergencyVehicle();


    glDisable(GL_CLIP_PLANE0);

    glutSwapBuffers();
}


// =====================================================
// CO5 - DYNAMIC VIEWPORT
// =====================================================

void reshape(int width, int height)
{
    if (height == 0)
        height = 1;

    glViewport(
        0,
        0,
        width,
        height
    );


    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();


    // 3D perspective
    if (is3D)
    {
        gluPerspective(
            45.0,
            (double)width / height,
            1.0,
            100.0
        );
    }

    // 2D orthographic view
    else
    {
        glOrtho(
            -15,
             15,
            -15,
             15,
            -50,
             50
        );
    }


    glMatrixMode(GL_MODELVIEW);
}


// =====================================================
// KEYBOARD CONTROLS
// =====================================================

void keyboard(
    unsigned char key,
    int x,
    int y
)
{
    switch (key)
    {
        // =============================================
        // VIEW MODE
        // =============================================

        case '2':
            is3D = false;
            break;

        case '3':
            is3D = true;
            break;


        // =============================================
        // MOVEMENT
        // =============================================

        // LEFT
        case 'a':
        case 'A':
            posX -= 0.5f;
            break;

        // RIGHT
        case 'd':
        case 'D':
            posX += 0.5f;
            break;

        // UP
        case 'w':
        case 'W':
            posY += 0.5f;
            break;

        // DOWN
        case 's':
        case 'S':
            posY -= 0.5f;
            break;


        // =============================================
        // ROTATION
        // =============================================

        case 'r':
        case 'R':
            rotation += 10.0f;
            break;


        // =============================================
        // SCALING
        // =============================================

        case '+':
            scaleValue += 0.1f;
            break;

        case '-':
            if (scaleValue > 0.2f)
                scaleValue -= 0.1f;
            break;


        // =============================================
        // RESET
        // =============================================

        case '0':
            posX = 0;
            posY = 0;
            posZ = 0;

            rotation = 0;
            scaleValue = 1;

            break;


        // =============================================
        // EXIT
        // =============================================

        case 27:
            exit(0);
    }


    // Update screen
    glutPostRedisplay();
}


// =====================================================
// INITIALIZATION
// =====================================================

void init()
{
    glEnable(GL_DEPTH_TEST);

    glClearColor(
        0.02f,
        0.04f,
        0.06f,
        1.0f
    );
}


// =====================================================
// MAIN
// =====================================================

int main(
    int argc,
    char** argv
)
{
    glutInit(
        &argc,
        argv
    );


    glutInitDisplayMode(
        GLUT_DOUBLE |
        GLUT_RGB |
        GLUT_DEPTH
    );


    glutInitWindowSize(
        900,
        650
    );


    glutCreateWindow(
        "Smart Traffic Light - 2D and 3D Computer Graphics"
    );


    init();


    glutDisplayFunc(display);

    glutReshapeFunc(reshape);

    glutKeyboardFunc(keyboard);


    glutMainLoop();


    return 0;
}